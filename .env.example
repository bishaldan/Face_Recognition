APP_NAME=FaceProof
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_PORT=5433
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SECRET_KEY=change-me-before-production
SESSION_COOKIE_NAME=face_recognition_session

DATABASE_URL=postgresql+psycopg://faceapp:faceapp@db:5432/faceapp

STORAGE_BACKEND=s3
STORAGE_BUCKET=faceproof
STORAGE_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SECURE=false
LOCAL_STORAGE_PATH=./data/storage

RECOGNITION_BACKEND=demo
ONNX_MODEL_PATH=
ONNX_INPUT_SIZE=112
DEFAULT_SIMILARITY_THRESHOLD=0.86
MIN_ENROLLMENT_CAPTURES=3

QUALITY_MIN_BRIGHTNESS=50
QUALITY_MAX_BRIGHTNESS=220
QUALITY_MIN_BLUR=75
QUALITY_MIN_FACE_RATIO=0.08

BOOTSTRAP_OPERATOR_USERNAME=admin
BOOTSTRAP_OPERATOR_PASSWORD=Admin123!
BOOTSTRAP_OPERATOR_DISPLAY_NAME=System Admin
